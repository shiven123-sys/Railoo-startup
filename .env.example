# Copy this file to .env and fill in real values before deploying.
# For local prototyping the defaults in settings.py already work with no .env at all.

DEBUG=True
SECRET_KEY=change-me-in-production-9f8a7d6c5b4e3f2a1
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave USE_POSTGRES=False to run on the bundled SQLite database (zero setup).
USE_POSTGRES=False
POSTGRES_DB=railoo
POSTGRES_USER=railoo
POSTGRES_PASSWORD=railoo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional integrations — the app runs fine with these blank; features that need
# them (live maps, SMS alerts, card payments) just show a "not configured" notice.
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
